PORT=3000
FRONTEND_URL="http://localhost:5173"
PUBLIC_API_URL="http://localhost:3000"

# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/che?schema=public"

# JWT (para el registro/login de usuarios, próxima etapa)
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
GOOGLE_CLIENT_ID="your-web-client-id.apps.googleusercontent.com"

# Google Calendar (sync de tareas). Mismo OAuth Client que el login.
# El redirect URI debe estar cargado en Google Cloud > Credenciales.
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:3000/api/calendar/callback"
# Clave para cifrar los refresh tokens (si falta, se deriva de JWT_SECRET)
TOKEN_ENCRYPTION_KEY="replace-with-another-long-random-string"

# Telegram: solo una instancia por bot puede recibir mensajes. Si otro del equipo ya
# tiene el back levantado con el mismo bot, poné false (igual podés enviar avisos).
TELEGRAM_POLLING=true

# Amazon Bedrock (próxima etapa, no se usa todavía)
AWS_REGION="us-east-1"
BEDROCK_MODEL_ID="anthropic.claude-3-haiku-20240307-v1:0"


# Mercado Pago (suscripciones de Che Pro)
# Credenciales de prueba: mercadopago.com.ar/developers/panel/app
MP_ACCESS_TOKEN=""
# Opcional: clave secreta del webhook para validar la firma
MP_WEBHOOK_SECRET=""
# Solo pruebas: email de un comprador de prueba de Mercado Pago (si usás credenciales de prueba).
MP_TEST_PAYER_EMAIL="TESTUSER1013825102694348560@testuser.com"
# URL del frontend a la que vuelve el usuario tras pagar (Mercado Pago exige https)
FRONTEND_URL="http://localhost:5173"
